{
  "name": "pink-labs-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "start": "electron .",
    "desktop": "npm run build && electron .",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.40.0",
    "@vitejs/plugin-react": "5.0.4",
    "lowlight": "3.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "electron": "^44.7.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "main": "electron/main.mjs"
}
